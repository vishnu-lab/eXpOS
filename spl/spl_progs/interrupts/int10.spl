[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 4] = TERMINATED;
alias i R1;
i= 1;

alias isTerminated R2;
isTerminated = 1;
while(i<MAX_PROC_NUM) do
  if([PROCESS_TABLE + i*16 + 4] != TERMINATED) then
    isTerminated = 0;
  endif;
  i = i + 1;
endwhile;

if(isTerminated == 1) then
  halt;
endif;

call SCHEDULER;
