breakpoint;
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 9] = -1;
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 13] = SP;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 11]*512 -1;
backup;
multipush(EIP);

if (EC == 0) then
  if (EPN>=4 && EPN<=7) then
    multipush(EPN);
    R1 = GET_CODE_PAGE;
    R2 = [DISK_MAP_TABLE + [SYSTEM_STATUS_TABLE + 1]*10 + EPN];
    call MEMORY_MANAGER;
    multipop(EPN);
    [[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 14] + 2*EPN] = R0;
    [[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 14] + 2*EPN + 1] = "1100";
    multipop(EIP);
    restore;
    SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 13];
    SP = SP + 1;
    [[[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 14] + 2*(SP/512)]*512 + (SP%512)] = EIP;
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 9] = 0;
    ireturn;
  endif;
  
  if (EPN>=2 && EPN<=3) then
    R1 =  GET_FREE_PAGE;
    call MEMORY_MANAGER;
    [[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 14] + 4] = R0;
    [[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 14] + 5] = "1110";
    R1 =  GET_FREE_PAGE;
    call MEMORY_MANAGER;
    [[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 14] + 6] = R0;
    [[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 14] + 7] = "1110";
    multipop(EIP);
    restore;
    SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 13];
    SP = SP + 1;
    [[[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 14] + 2*(SP/512)]*512 + (SP%512)] = EIP;
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 9] = 0;
    ireturn;
  endif;
endif;

if (EC == 1) then
  R1 = TERMINAL_WRITE;
  R2 = [SYSTEM_STATUS_TABLE + 1];
  R3 = "Illegal Instruction";
  call DEVICE_MANAGER;
endif;

if (EC == 2) then
  R1 = TERMINAL_WRITE;
  R2 = [SYSTEM_STATUS_TABLE + 1];
  R3 = "Illegal memory access";
  call DEVICE_MANAGER;
endif; 
 
if (EC == 3) then
  R1 = TERMINAL_WRITE;
  R2 = [SYSTEM_STATUS_TABLE + 1];
  R3 = "Arithmetic Exception";
  call DEVICE_MANAGER;
endif; 

R1 = EXIT_PROCESS;
R2 = [SYSTEM_STATUS_TABLE + 1];
call PROCESS_MANAGER;
