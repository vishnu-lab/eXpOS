alias functionNum R1;
alias currentPID R2;

if (functionNum == ACQUIRE_TERMINAL) then
  while([TERMINAL_STATUS_TABLE] == 1) do
    [PROCESS_TABLE + currentPID*16 + 4] = WAIT_TERMINAL;
    multipush(R1,R2,R3);
    call SCHEDULER;
    multipop(R1,R2,R3);
  endwhile;
  [TERMINAL_STATUS_TABLE] = 1;
  [TERMINAL_STATUS_TABLE + 1] = currentPID;
  return;
endif;

if (functionNum == RELEASE_TERMINAL) then
  if(currentPID != [TERMINAL_STATUS_TABLE + 1]) then
    R0 = -1;
    return;
  endif;
  [TERMINAL_STATUS_TABLE] = 0;
  [TERMINAL_STATUS_TABLE + 1] = -1;

  alias i R4;
  i = 0;

  while(i<MAX_PROC_NUM) do
    if([PROCESS_TABLE + i*16 + 4] == WAIT_TERMINAL) then
      [PROCESS_TABLE + i*16 + 4] = READY;
    endif;
    i = i + 1;
  endwhile;
  R0 = 0;
  return;
endif;

if (functionNum == ACQUIRE_DISK) then
  while([DISK_STATUS_TABLE] == 1) do
    [PROCESS_TABLE + currentPID*16 + 4] = WAIT_DISK;
    multipush(R1,R2);
    call SCHEDULER;
    multipop(R1,R2);
  endwhile;
  
  [DISK_STATUS_TABLE] = 1;
  [DISK_STATUS_TABLE + 4] = currentPID;
  return;
endif;

if (functionNum == ACQUIRE_SEMAPHORE) then
  alias i R0;
  i = 0;
  while (i<MAX_SEM_COUNT) do
    if ([SEMAPHORE_TABLE + 4*i + 1] == 0) then
      break;
    endif;
    i = i + 1;
  endwhile;

  if (i<MAX_SEM_COUNT) then
    [SEMAPHORE_TABLE + 4*i] = -1;
    [SEMAPHORE_TABLE + 4*i + 1] = 1;
  else
    i = -1;
  endif;
  return;
endif;

if (functionNum == RELEASE_SEMAPHORE) then
  alias sid R2;
  alias pid R3;
  if ([SEMAPHORE_TABLE + 4*sid] == pid) then
    [SEMAPHORE_TABLE + 4*sid] = -1;
    alias i R4;
    i = 0;
    while (i<MAX_PROC_NUM) do
      if ([PROCESS_TABLE + i*16 + 4] == WAIT_SEMAPHORE && [PROCESS_TABLE + i*16 + 5] == sid) then
        [PROCESS_TABLE + i*16 + 4] = READY;
      endif;
      i = i + 1;
    endwhile;
  endif;
 
  [SEMAPHORE_TABLE + 4*sid + 1] = [SEMAPHORE_TABLE + 4*sid + 1] - 1;
endif;

  

return;
