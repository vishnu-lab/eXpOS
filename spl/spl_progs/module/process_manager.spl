alias functionNum R1;
alias Pid R2;

if (functionNum == FREE_USER_AREA_PAGE) then
  alias userArea R3;
  userArea = [PROCESS_TABLE + Pid*16 + 11];
  alias i R4;
  i = 0;
  while (i<8) do
    if ([userArea*512 + RESOURCE_TABLE_OFFSET + 2*i] == SEMAPHORE) then
      multipush(R0,R1,R2,R3,R4);
      R1 = RELEASE_SEMAPHORE;
      R5 = Pid;
      R2 = [userArea*512 + RESOURCE_TABLE_OFFSET + 2*i +1];
      R3 = R5;
      call RESOURCE_MANAGER;
      multipop(R0,R1,R2,R3,R4);
    endif;
    i = i + 1;
  endwhile;
      
  multipush(R1,R2,R3);
  R1 = RELEASE_PAGE;
  R2 = userArea;
  call MEMORY_MANAGER;
  multipop(R1,R2,R3);
  return;
endif;

if (functionNum == EXIT_PROCESS) then
  multipush(R1,R2,R3);
  functionNum = FREE_PAGE_TABLE;
  call PROCESS_MANAGER;
  multipop(R1,R2,R3);
  
  multipush(R1,R2,R3);
  functionNum = FREE_USER_AREA_PAGE;
  call PROCESS_MANAGER;
  multipop(R1,R2,R3);
  
  [PROCESS_TABLE + Pid*16 + 4] = TERMINATED;
  if ([PROCESS_TABLE + Pid*16 + 9] != INT_EXEC) then
    alias i R4;
    i = 0;
    while (i<MAX_PROC_NUM) do

      if ([PROCESS_TABLE + i*16 + 2] == Pid) then
         [PROCESS_TABLE + i*16 + 2] = -1;
      endif;

      if ([PROCESS_TABLE + i*16 + 4] == WAIT_PROCESS && [PROCESS_TABLE + i*16 + 5] == Pid) then
        [PROCESS_TABLE + i*16 + 4] = READY;
      endif;

      i = i + 1;

    endwhile;
  endif;
  return;
endif;


if (functionNum == FREE_PAGE_TABLE) then
  alias pagetable R3;
  alias length R4;
  pagetable = [PROCESS_TABLE + Pid*16 + 14];
  length = [PROCESS_TABLE + Pid*16 + 15];
  
  [pagetable] = -1;
  [pagetable + 1] = "0000";
  [pagetable + 2] = -1;
  [pagetable + 3] = "0000";
  
  alias i R5;
  i = 3;
  while (i <= length) do
   alias bits R6;
   bits = [pagetable + 2*i -1];
   if (bits == "0100" || bits == "0101" || bits == "0110" || bits == "0111" || bits == "1100" || bits == "1101" || bits == "1110" || bits == "1111") then
     multipush(R1,R2,R3,R4,R5,R6);
     functionNum = RELEASE_PAGE;
     R2 = [pagetable + 2*i - 2];
     call MEMORY_MANAGER;
     multipop(R1,R2,R3,R4,R5,R6);
     [pagetable + 2*i - 1] = "0000";
     [pagetable + 2*i - 2] = -1;
   endif;
   i = i+1;
  endwhile;
  
  //releasing disk pages of heap
  i = 2;
  while (i<=3) do
    if ([DISK_MAP_TABLE + Pid*10 + i] != -1) then
      multipush(R1,R2,R3,R4,R5,R6);
      R1 = RELEASE_BLOCK;
      R3 = Pid;
      R2 = [DISK_MAP_TABLE + Pid*10 + i];
      call MEMORY_MANAGER;
      multipop(R1,R2,R3,R4,R5,R6);
      [DISK_MAP_TABLE + Pid*10 + i] = -1;
    endif;
    i = i + 1;
  endwhile;  

  //releasing disk pages of stack
  i = 8;
  while (i<=9) do
    if ([DISK_MAP_TABLE + Pid*10 + i] != -1) then
      multipush(R1,R2,R3,R4,R5,R6);
      R1 = RELEASE_BLOCK;
      R3 = Pid;
      R2 = [DISK_MAP_TABLE + Pid*10 + i];
      call MEMORY_MANAGER;
      multipop(R1,R2,R3,R4,R5,R6);
      [DISK_MAP_TABLE + Pid*10 + i] = -1;
    endif;
    i = i + 1;
  endwhile;  

return;
endif;

if (functionNum == GET_PCB_ENTRY) then
  alias i R0;
  i = 0;
  while (i<MAX_PROC_NUM) do
    if ([PROCESS_TABLE + i*16 + 4] == TERMINATED) then
      break;
    endif;
    i = i + 1;
  endwhile;
  if (i == MAX_PROC_NUM) then
    i = -1;
  else
    [PROCESS_TABLE + i*16 + 1] = i;
    [PROCESS_TABLE + i*16 + 4] = ALLOCATED;
    [PROCESS_TABLE + i*16 + 14] = PAGE_TABLE_BASE + i*20;
    [PROCESS_TABLE + i*16 + 15] = 10;
  endif;
  return;
endif;
