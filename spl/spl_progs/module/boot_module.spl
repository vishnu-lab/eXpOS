
//loading int 6 module
loadi(14,27);
loadi(15,28);

//loading int 7 module
loadi(16,29);
loadi(17,30);

//loading int 8 module
loadi(18,31);
loadi(19,32);

//loading int 9 module
loadi(20,33);
loadi(21,34);

//loading int 10 module
loadi(22,35);
loadi(23,36);

//loading int 11 module
loadi(24,37);
loadi(25,38);

//loading int 15 module
loadi(32,45);
loadi(33,46);

//loading timer interrupt
loadi(4, 17);
loadi(5, 18);

//loading console interrupt
loadi(8, 21);
loadi(9, 22);

//loading disk interrupt
loadi(6, 19);
loadi(7, 20);

//load resource manager module
loadi(40,53);
loadi(41,54);

//load process manager module
loadi(42,55);
loadi(43,56);

//load memory manager module
loadi(44,57);
loadi(45,58);

//load device manager module
loadi(48,61);
loadi(49,62);

//loading scheduler module
loadi(50,63);
loadi(51,64);

//loading exception handler
loadi(2, 15);
loadi(3, 16);

//loading library
loadi(63,13);
loadi(64,14);

//loading inodetable
loadi(59,3);
loadi(60,4);

//loading init program
loadi(65,7);
loadi(66,8);

//initializing disk status table
[DISK_STATUS_TABLE] = 0;

//set the state of all process table entries to TERMINATED
alias process_id R1;
process_id = 0;

while( process_id < MAX_PROC_NUM ) do
[PROCESS_TABLE + process_id*16 + 4] = TERMINATED;
process_id = process_id + 1;
endwhile;



 //creating page table entries for init program
 PTBR = PAGE_TABLE_BASE + 20;
 PTLR = 10;

 //setting up the values of page table

 //Library setup
 [PTBR    ] = 63;
 [PTBR + 1] = "0100";
 [PTBR + 2] = 64;
 [PTBR + 3] = "0100";

 //Heap setup
 [PTBR + 4] = 78;
 [PTBR + 5] = "0110";
 [PTBR + 6] = 79;
 [PTBR + 7] = "0110";

 //Setting up code segments
 [PTBR + 8] =  65;
 [PTBR + 9] =  "0100";
 [PTBR + 10] = -1;
 [PTBR + 11] = "0000";
 [PTBR + 12] = -1;
 [PTBR + 13] = "0000";
 [PTBR + 14] = -1;
 [PTBR + 15] = "0000";

 //Stack setup
 [PTBR + 16] = 76;
 [PTBR + 17] = "0110";
 [PTBR + 18] = 77;
 [PTBR + 19] = "0110";




//setting up process table entries for init process
process_id = 1;

//PID
[PROCESS_TABLE + process_id*16 + 1] = 1;
//state 
[PROCESS_TABLE + process_id*16 + 4] = CREATED;
//user area page num
[PROCESS_TABLE + process_id*16 + 11] = 80;
//KTPR
[PROCESS_TABLE + process_id*16 + 12] = 0;
//UTPR
[PROCESS_TABLE + process_id*16 + 13] = 8*512;
//PTBR
[PROCESS_TABLE + process_id*16 + 14] = PAGE_TABLE_BASE+20;
//PTLR
[PROCESS_TABLE + process_id*16 + 15] = 10;

//initializing the pre-resource table of init process
alias i R3;
i = 495;

while (i<512) do 
  [[PROCESS_TABLE + process_id*16 + 11]*512 + i] = -1;
  i = i + 1;
endwhile;

R2 = SP;
SP = 76*512-1;
R0 = [65*512 +1];
multipush(R0);

//initializing disk map table for init process
[DISK_MAP_TABLE + 10 + 4] = 7;
[DISK_MAP_TABLE + 10 + 5] = 8;

//initilaizing the mem free list
i = 0;
while (i <= 82) do
  [MEMORY_FREE_LIST + i] = 1;
  i = i + 1;
endwhile;

[SYSTEM_STATUS_TABLE + 2] = 45;

//moving back to original stack (kernel stack of idle process)
SP = R2;
return;
